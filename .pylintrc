[MAIN]
py-version=3.14
jobs=0
ignore=venv,mobile,api,.idea,log,modelo-ui,dist,build
ignore-paths=^mobile/.*,^api/.*,^modelo-ui/templates/.*
init-hook='import sys; from pathlib import Path; sys.path.insert(0, str(Path.cwd()))'

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    too-many-instance-attributes,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-locals,
    too-many-return-statements,
    too-many-statements,
    too-many-branches,
    too-many-lines,
    too-many-public-methods,
    broad-exception-caught,
    duplicate-code,
    import-outside-toplevel,
    import-error,
    invalid-name,
    non-ascii-name,
    line-too-long,
    protected-access,
    fixme,
    consider-using-with,
    consider-using-from-import,
    consider-using-max-builtin,
    unused-argument,
    unused-import,
    unused-variable,
    unnecessary-lambda,
    unnecessary-comprehension,
    no-else-return,
    no-else-raise,
    no-else-break,
    no-else-continue,
    unsubscriptable-object,
    redefined-outer-name,
    attribute-defined-outside-init,
    global-statement,
    wrong-import-order,
    missing-final-newline,
    comparison-with-itself,
    use-maxsplit-arg,
    unpacking-non-sequence

[FORMAT]
max-line-length=120

[DESIGN]
max-args=12
max-locals=25
max-returns=10
max-attributes=20

[BASIC]
good-names=i,j,k,x,y,e,_,df,dt,cx,cy,id,ok,ui

[TYPECHECK]
generated-members=
    tkinter.*,
    ttk.*,
    customtkinter.*,
    matplotlib.*,
    winfo_exists,
    winfo_toplevel,
    after,
    after_cancel

[REPORTS]
score=no
